#!/usr/bin/env bash
set -Eeuo pipefail

archive=${1:-}
release_sha=${2:-}
checksum_file=$archive.sha256
install_root=/opt/ygate
release_dir=$install_root/releases/$release_sha
current_link=$install_root/current
environment_file=/etc/ygate/ygate.env
backup_dir=/var/backups/ygate

if [[ ! -f $archive || ! -f $checksum_file || ! $release_sha =~ ^[0-9a-f]{40}$ || ! -f $environment_file || -e $release_dir ]]; then
    echo "invalid archive, release SHA, environment file, or duplicate release" >&2
    exit 1
fi

(cd "$(dirname "$archive")" && sha256sum --check "$(basename "$checksum_file")")

install -d -o ygate -g ygate "$release_dir" "$backup_dir"
tar -xzf "$archive" -C "$release_dir"
test -x "$release_dir/bin/platform-api"
test -x "$release_dir/bin/api-gateway"
test -x "$release_dir/bin/auth-service"
test -f "$release_dir/web/server.js"
test -f "$release_dir/platform-api.yaml"
[[ $(<"$release_dir/VERSION") == "$release_sha" ]]
chown -R ygate:ygate "$release_dir"

previous_release=$(readlink -f "$current_link" || true)

restart_all() {
    systemctl restart ygate-platform-api ygate-auth-service ygate-api-gateway ygate-web
}

rollback() {
    echo "deployment failed; rolling back to $previous_release" >&2
    if [[ -n $previous_release && -d $previous_release ]]; then
        ln -sfn "$previous_release" "$current_link.rollback"
        mv -Tf "$current_link.rollback" "$current_link"
        restart_all
    fi
}
trap rollback ERR

set -a
# shellcheck disable=SC1090
source "$environment_file"
set +a

timestamp=$(date -u +%Y%m%dT%H%M%SZ)
pg_dump --format=custom --file="$backup_dir/ygate-$timestamp.dump" "$PLATFORM_DATABASE_URL"

ln -sfn "$release_dir" "$current_link.next"
mv -Tf "$current_link.next" "$current_link"

wait_for() {
    local url=$1
    for _ in {1..30}; do
        if curl --fail --silent --show-error "$url" >/dev/null; then
            return 0
        fi
        sleep 2
    done
    return 1
}

systemctl restart ygate-platform-api
wait_for http://127.0.0.1:44441/readyz
systemctl restart ygate-auth-service
wait_for http://127.0.0.1:44442/readyz
systemctl restart ygate-api-gateway
wait_for http://127.0.0.1:44440/gateway/healthz
wait_for http://127.0.0.1:44440/readyz
systemctl restart ygate-web
wait_for http://127.0.0.1:8080/

trap - ERR
rm -f "$archive" "$checksum_file"
echo "deployed YGATE $release_sha"
