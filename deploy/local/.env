# Middleware software-update patches are downloaded by the middleware client
# itself via this URL (through the Gateway, not platform-api's private port).
# If the middleware runs on another machine on the LAN, replace 127.0.0.1
# with this dev machine's LAN IP so it's actually reachable.
PLATFORM_PUBLIC_BASE_URL=http://127.0.0.1:44440
NEXT_PUBLIC_GATEWAY_URL=http://127.0.0.1:44440
PLATFORM_BOOTSTRAP_EMAIL=admin@ygate.local
PLATFORM_BOOTSTRAP_USERNAME=admin
PLATFORM_BOOTSTRAP_DISPLAY_NAME=Ygate Admin
