# Copy this file to license-keys.env and keep that file private.
# Only public keys belong here. Never put CHPP_LICENSE_PRIVATE_KEY in a customer build package.

# Build will use DEFAULT if CHPP_LICENSE_KEY_NAME is not set.
CHPP_LICENSE_KEY_NAME=DEFAULT
CHPP_LICENSE_PUBLIC_KEY_DEFAULT=<BASE64_ED25519_PUBLIC_KEY>

# Optional additional public keys for different product/customer generations.
# CHPP_LICENSE_PUBLIC_KEY_CHPP2026=<BASE64_ED25519_PUBLIC_KEY>
# CHPP_LICENSE_PUBLIC_KEY_DEMO=<BASE64_ED25519_PUBLIC_KEY>
